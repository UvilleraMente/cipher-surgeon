/* Type-checks the framework-free core, its tests, the CLI and the library entry (run by `npm run typecheck`). */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/core",
    "lib": ["es2022", "dom"],
    "types": ["node"]
  },
  "include": ["src/core/**/*.ts", "cli/**/*.ts", "lib/**/*.ts", "vitest.config.ts"]
}
