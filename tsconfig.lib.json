/* Emits the type declarations of the npm package (run by `npm run build:lib`). */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./lib/dist/types",
    "declaration": true,
    "emitDeclarationOnly": true,
    "lib": ["es2022", "dom"],
    "types": []
  },
  "files": ["lib/index.ts"]
}
